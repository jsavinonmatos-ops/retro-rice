/* retro-rice · menús de lista (portapapeles, WiFi, Bluetooth, IA, calendario): cristal oscuro */
* {
  fg: #ffffff;
  dim: #8c8c8c;
  background-color: transparent;
  text-color: @fg;
  font: "Inter 12";
}

window {
  location: center;
  width: 640px;
  background-color: #000000a6;
  border: 1px;
  border-color: #ffffff40;
  border-radius: 20px;
}

mainbox { padding: 18px; spacing: 12px; children: [ inputbar, message, listview ]; }

inputbar {
  padding: 12px 16px;
  spacing: 10px;
  background-color: #ffffff14;
  border-radius: 12px;
  children: [ prompt, entry ];
}
prompt { text-color: #fafafa; }
entry { placeholder: "Escribe para filtrar…"; placeholder-color: @dim; }

message { padding: 6px 4px; }
textbox { text-color: @fg; markup: true; }

listview { lines: 9; columns: 1; spacing: 4px; fixed-height: false; scrollbar: false; }

element { padding: 12px 16px; spacing: 12px; border-radius: 10px; }
element-text, element-icon { background-color: inherit; text-color: inherit; }
element selected normal, element selected urgent, element selected active { background-color: #fafafa; text-color: #000000; }
