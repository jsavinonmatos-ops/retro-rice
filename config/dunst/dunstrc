[global]
    monitor = 0
    follow = mouse
    width = (340, 440)
    origin = top-right
    offset = 16x70
    notification_limit = 5
    padding = 16
    horizontal_padding = 16
    frame_width = 1
    frame_color = "#fafafaaa"
    gap_size = 8
    corner_radius = 12
    font = Inter 10
    markup = full
    format = "<b>%s</b>\n%b"
    icon_theme = Papirus-Dark
    enable_recents = true
    transparency = 0

[urgency_low]
    background = "#000000dd"
    foreground = "#8c8c8c"
    timeout = 4

[urgency_normal]
    background = "#000000dd"
    foreground = "#ffffff"
    timeout = 6

[urgency_critical]
    background = "#fafafa"
    foreground = "#000000"
    frame_color = "#fafafa"
    timeout = 0
