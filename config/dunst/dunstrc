[global]
    monitor = 0
    follow = mouse
    width = (340, 440)
    origin = top-right
    offset = 16x70
    notification_limit = 5
    padding = 16
    horizontal_padding = 16
    frame_width = 1
    frame_color = "#fafafaaa"
    gap_size = 8
    corner_radius = 12
    font = Inter 10
    markup = full
    format = "<b>%s</b>\n%b"
    icon_theme = Papirus-Dark
    enable_recents = true
    transparency = 0
    # barra de progreso (la usa el aviso de batería: porcentaje) con estilo cristal
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4
    progress_bar_min_width = 150
    progress_bar_max_width = 300

# Cristal: fondo oscuro translúcido; picom desenfoca lo que hay detrás de la notificación
[urgency_low]
    background = "#000000a6"
    foreground = "#8c8c8c"
    highlight = "#8c8c8c"
    timeout = 4

[urgency_normal]
    background = "#000000b3"
    foreground = "#ffffff"
    highlight = "#fafafa"
    timeout = 6

# Críticas (batería muy baja, etc.): mismo cristal, con tinte y borde rojo (el rojo de la batería en la barra)
[urgency_critical]
    background = "#1e060cc2"
    foreground = "#ffffff"
    frame_color = "#ff5370dd"
    highlight = "#ff5370"
    timeout = 0
