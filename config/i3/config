# mono-rice · i3 (tiling). Sesión aparte de XFCE: se elige en el login.
# Guía de atajos: Super+F1

set $mod Mod4
font pango:Inter 9

floating_modifier $mod
focus_follows_mouse no
hide_edge_borders smart

# --- aspecto: bordes finos, huecos entre ventanas (esquinas redondeadas y blur los pone picom) ---
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 2

client.focused          #fafafa #000000 #fafafa #fafafa #fafafa
client.focused_inactive #444444 #000000 #888888 #444444 #444444
client.unfocused        #222222 #000000 #888888 #222222 #222222
client.urgent           #fafafa #fafafa #000000 #fafafa #fafafa
client.placeholder      #000000 #000000 #ffffff #000000 #000000
client.background       #000000

# --- arranque ---
# DPI de la sesión i3 (más compacto que XFCE, que usa 120). Para cambiarlo: edita el 108.
exec_always --no-startup-id mono-session-dpi 108
exec_always --no-startup-id $HOME/.config/picom/start.sh anim
exec_always --no-startup-id $HOME/.config/polybar/launch.sh
exec_always --no-startup-id sh -c '[ -x $HOME/.fehbg ] && $HOME/.fehbg || mono-wall'
exec --no-startup-id xfsettingsd
exec --no-startup-id dunst
exec_always --no-startup-id mono-touch apply
exec --no-startup-id unclutter --timeout 2 --jitter 5 --ignore-scrolling
exec --no-startup-id numlockx on
exec --no-startup-id lxpolkit
exec --no-startup-id nm-applet
exec --no-startup-id xss-lock --transfer-sleep-lock -- mono-lock --nofork

# --- apps ---
bindsym $mod+Return exec --no-startup-id kitty
bindsym $mod+space  exec --no-startup-id rofi -show drun
bindsym $mod+d      exec --no-startup-id rofi -show drun
bindsym $mod+Tab    exec --no-startup-id rofi -show window
bindsym $mod+b      exec --no-startup-id mono-browser
bindsym $mod+Shift+f exec --no-startup-id thunar
bindsym $mod+k      exec --no-startup-id onboard
bindsym $mod+w      exec --no-startup-id mono-wall
bindsym $mod+i      exec --no-startup-id kitty --class mono-ai -e mono-ai
bindsym $mod+Shift+t exec --no-startup-id mono-touch toggle
bindsym $mod+Shift+w exec --no-startup-id mono-wall mono
bindsym $mod+Escape exec --no-startup-id mono-lock
bindsym Print       exec --no-startup-id xfce4-screenshooter -r
bindsym $mod+F1     exec --no-startup-id kitty --class cheatsheet -e sh -c 'less $HOME/.config/i3/cheatsheet.txt'

# --- ventanas ---
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent

# foco: flechas, o h/j/l/u (la k la usa el teclado en pantalla)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+l focus right
bindsym $mod+u focus up
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# cómo se divide la próxima ventana y el layout
bindsym $mod+minus     split v
bindsym $mod+backslash split h
bindsym $mod+e layout toggle split
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed

# --- workspaces ---
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Control+Right workspace next
bindsym $mod+Control+Left  workspace prev

# --- redimensionar ---
mode "resize" {
    bindsym h resize shrink width 40 px or 4 ppt
    bindsym j resize grow height 40 px or 4 ppt
    bindsym k resize shrink height 40 px or 4 ppt
    bindsym l resize grow width 40 px or 4 ppt
    bindsym Left  resize shrink width 40 px or 4 ppt
    bindsym Down  resize grow height 40 px or 4 ppt
    bindsym Up    resize shrink height 40 px or 4 ppt
    bindsym Right resize grow width 40 px or 4 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# --- sesión ---
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+p exec --no-startup-id mono-power
bindsym $mod+Shift+e exec --no-startup-id i3-nagbar -t warning -m 'Salir de i3 y volver al login?' -B 'Sí, salir' 'i3-msg exit'

# --- teclas multimedia del portátil ---
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# --- ventanas que mejor flotan ---
for_window [class="(?i)pavucontrol|onboard|nm-connection-editor|arandr|xfce4-screenshooter|xfce4-appfinder|lxpolkit"] floating enable
for_window [class="mono-ai"] floating enable, resize set 1000 700, move position center
for_window [class="cheatsheet"] floating enable, resize set 900 620, move position center
